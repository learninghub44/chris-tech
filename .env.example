# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Instructions:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings > API
# 3. Copy the Project URL and anon/public key
# 4. For service role key, go to Settings > API > Service Role Key
# 5. Set these as environment variables in your deployment platform (Vercel, Netlify, etc.)

# Deriv OAuth (client/app ID and redirect are set in lib/deriv-config.ts)
# Redirect URL registered on Deriv: https://tradehub.christech.co.ke/callback
# Leave DERIV_APP_ID unset so it doesn't override the value in code
# DERIV_APP_ID=34t6D3VOm0Kv3LadCeJjL

# Admin login (REQUIRED in production - code falls back to a weak default otherwise)
ADMIN_USERNAME=
ADMIN_PASSWORD=
